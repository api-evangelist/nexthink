{
  "opencollection": "1.0.0",
  "info": {
    "name": "Campaigns enrichment API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "enrichment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Enrich fields for given objects",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.api.{region}.nexthink.cloud/api/v1/enrichment/data/fields",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enrichment can be done for manual custom fields (any object), virtualization fields (devices only), configuration_tag for devices, the organization field (users only), or the Entra ID fields (users only).\n"
        }
      ]
    }
  ],
  "bundled": true
}