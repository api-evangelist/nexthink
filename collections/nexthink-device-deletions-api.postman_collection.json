      "item": [
        {
          "id": "dfdc5621-4577-42be-916e-77d27500cdc8",
          "name": "Schedule device deletions",
          "request": {
            "name": "Schedule device deletions",
            "description": {
              "content": "Schedule the deletion of one or more devices from the Nexthink inventory.\n\nEach device must be identified by both its `uid` and `name`. Devices with malformed\nUIDs are rejected individually with status `INVALID` without failing the rest of the\nbatch.\n\nThe operation is asynchronous: the API returns `202 Accepted` once the deletions are\nqueued. Actual removal from the inventory happens in the background.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "data-management",
                "device",
                "deletions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Nexthink instance name",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                },
                {
                  "description": "Nexthink cloud region (This can only be one of us,eu,pac,meta)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional client-supplied correlation identifier (UUID). Echoed back in the response `x-request-id` header. If omitted, the server generates one.",
                "key": "x-request-id",
                "value": "<uuid>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"devices\": [\n    {\n      \"uid\": \"<uuid>\",\n      \"name\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "a625cd8f-81de-405b-8cbf-4f63d4bee1a9",
              "name": "Deletion batch accepted and queued. Check each device's `status` field — a `202` response does not guarantee all devices were successfully scheduled.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "data-management",
                    "device",
                    "deletions"
