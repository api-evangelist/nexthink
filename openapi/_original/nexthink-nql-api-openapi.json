            "items": {
              "type": "string"
            }
          },
          "data": {
            "type": "array",
            "description": "List of rows with the data returned by the query execution.",
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      },
      "DateTime": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int64"
          },
          "month": {
            "type": "integer",
            "format": "int64"
          },
          "day": {
            "type": "integer",
            "format": "int64"
          },
          "hour": {
            "type": "integer",
            "format": "int64"
          },
          "minute": {
            "type": "integer",
            "format": "int64"
          },
          "second": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
